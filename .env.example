# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/kaamsetu

# JWT — use a long random string, never commit the real value
JWT_SECRET=replace_with_a_long_random_secret

# Fast2SMS — real OTP delivery
FAST2SMS_API_KEY=your_fast2sms_api_key


# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Admin credentials — use strong values in production
ADMIN_USERNAME=admin
ADMIN_SECRET_PASSWORD=change_this_before_deploy
ADMIN_EMAIL=admin@example.com

# Email / Gmail SMTP
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password

# Cloudinary — for Aadhar card and profile photo uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Mappls API keys
MAPPLS_CLIENT_ID=your_client_id_here
MAPPLS_CLIENT_SECRET=your_client_secret_here

# Admin Email (receives "New Job Request" notifications)
ADMIN_EMAIL=admin@example.com

# Gmail SMTP settings (used for sending OTPs, approval emails, job notifications)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://kaamsetu.live

NODE_ENV=development
